# ===================================
# Backend - Variables de Entorno
# ===================================
#
# IMPORTANTE: Este archivo está OBSOLETO y se mantiene solo por compatibilidad.
#
# ✅ USA EL ARCHIVO PRINCIPAL: ../.env
#
# INSTRUCCIONES:
# 1. Ve a la raíz del proyecto (carpeta padre)
# 2. Copia ../.env.example a ../.env
# 3. Configura las variables en ../.env
#
# El backend leerá automáticamente las variables de ../.env
# cuando se ejecute desde la raíz del proyecto.
#
# Si REALMENTE necesitas un .env específico para el backend
# (por ejemplo, para testing aislado), copia estas variables:
#
# ===================================

# Servidor
PORT=3000
NODE_ENV=development

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticketvue
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql_aqui

# Autenticación JWT (REQUERIDO)
JWT_SECRET=cambiar_esta_clave_secreta_en_produccion
JWT_EXPIRE=7d

# Email / SMTP (REQUERIDO para envío de tickets)
EMAIL_SERVICE=gmail
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion_aqui
EMAIL_FROM="Sistema de Boletería TicketVue <noreply@ticketvue.com>"

# ===================================
# NOTA: Para documentación completa y todas las opciones,
# consulta el archivo ../.env.example en la raíz del proyecto
# ===================================
